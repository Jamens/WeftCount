# ============================================================
# docker compose 环境变量示例
#   cp .env.docker.example .env   然后按需修改
# 说明：本文件仅含占位值，不含任何真实凭证。
# ============================================================

# ---- MySQL ----
DB_PASSWORD=weft_change_me     # 生产务必改成强密码
DB_NAME=weft_count
# 宿主机映射端口。默认 3306 常被本机已装的 MySQL 占用，可改 13306 等
DB_PORT=3306

# ---- 服务端口 ----
SERVER_PORT=3180
ADMIN_PORT=5180

# ---- 跨域 ----
# 管理端经 nginx 同源反代时可不设；生产请收敛为具体域名，不要用 *

# ---- 种子数据 ----
# true = 启动时写入演示租户/角色/账号/物料/规格/件卡（**生产建议 false**）
SEED_ON_START=true

# ---- JWT 签名密钥（重要）----
# 不设则容器启动时自动生成随机密钥（重启后失效需重新登录）。
# 生产务必固定：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 绝不要沿用代码里的开发默认值——开源仓库里人人可见，可伪造任意管理员令牌。
JWT_SECRET=

# ---- 大模型（可选）----
# 不配置则 AI 五能力全部走确定性规则兜底（成本/价带/统计照常输出）
# AI_API_KEY=sk-your-key
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_ENABLED=false   # 显式总开关：即使配了 key 也不调用模型

# ── 安全配置 ──────────────────────────────────────────────
# CORS 白名单：逗号分隔。留空 = 拒绝一切跨源
# （管理端由 nginx 同源反代，本就用不到 CORS）。
CORS_ORIGIN=
# API 文档：生产默认关闭；置 true 开启。
SWAGGER_ENABLED=false
# 文档页 Basic Auth（SWAGGER_ENABLED=true 且两项都填时才启用）。
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASSWORD=
# 限速：单 IP 窗口内请求数 / 窗口长度（毫秒）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1200
RATE_LIMIT_TTL=60000
# 登录端点单独收紧：单 IP 每分钟最多尝试次数。
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_TTL=60000
# 反向代理信任跳数：1 = 「nginx → server」那一层。
TRUST_PROXY=1
