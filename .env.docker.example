# ============================================================
# docker compose 环境变量示例
#   cp .env.docker.example .env   然后按需修改
# 说明：本文件仅含占位值，不含任何真实凭证。
# ============================================================

# ---- MySQL ----
DB_PASSWORD=weft_change_me     # 生产务必改成强密码
DB_NAME=weft_count
# 宿主机映射端口。默认 3306 常被本机已装的 MySQL 占用，可改 13306 等
DB_PORT=3306

# ---- 服务端口 ----
SERVER_PORT=3180
ADMIN_PORT=5180

# ---- 跨域 ----
# 管理端经 nginx 同源反代时可不设；生产请收敛为具体域名，不要用 *
CORS_ORIGIN=*

# ---- 种子数据 ----
# true = 启动时写入演示租户/角色/账号/物料/规格/件卡（**生产建议 false**）
SEED_ON_START=true

# ---- 大模型（可选）----
# 不配置则 AI 五能力全部走确定性规则兜底（成本/价带/统计照常输出）
# AI_API_KEY=sk-your-key
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_ENABLED=false   # 显式总开关：即使配了 key 也不调用模型
