# ============================================================
# WeftCount · 管理端 nginx 配置（模板）
# ------------------------------------------------------------
# 由 nginx 官方镜像的 envsubst 机制渲染：/etc/nginx/templates/*.template
# → /etc/nginx/conf.d/*.conf，环境变量 ${BACKEND_HOST} / ${API_PREFIX} 会被替换。
#
# 注意：upstream 的 server 指令**只接受 host:port，不能带 http://**，
#      故用 BACKEND_HOST 而非完整 URL（带 scheme 会报 emerg invalid host in upstream）。
#
# 三件事：
#   1) SPA history 路由回退（try_files → index.html），刷新 /alerts 这类路径不 404
#   2) /api 反代到后端容器——前端用相对路径，无需在构建期注入地址
#   3) 带 hash 的静态资源长缓存，index.html 不缓存（保证发版即时生效）
# ============================================================

upstream backend {
    server ${BACKEND_HOST};
    keepalive 16;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 上传/导出可能较大，放宽 body 与超时
    client_max_body_size 32m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location ${API_PREFIX}/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 后端鉴权依赖这两个头（请求头），必须透传
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
    }

    # 带内容 hash 的静态资源：长缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # 入口 HTML 不缓存，保证发版后立即生效
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # SPA history 路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}