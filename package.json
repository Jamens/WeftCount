{
  "name": "weftcount",
  "version": "0.1.0",
  "private": true,
  "description": "纬数 WeftCount · 纺织行业 AI 进销存系统",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @weftcount/shared build",
    "build:server": "pnpm --filter @weftcount/server build",
    "build:admin": "pnpm --filter @weftcount/admin build",
    "build:desktop": "pnpm --filter @weftcount/desktop build",
    "build": "pnpm run build:shared && pnpm run build:server && pnpm run build:admin && pnpm run build:desktop",
    "dev:server": "pnpm --filter @weftcount/server dev",
    "dev:admin": "pnpm --filter @weftcount/admin dev",
    "dev:desktop": "pnpm --filter @weftcount/desktop dev",
    "start:desktop": "node scripts/start-desktop.mjs",
    "start:desktop:dev": "node scripts/start-desktop.mjs --dev",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run build",
    "test:smoke": "node test/smoke/run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}