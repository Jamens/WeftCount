# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234560
DB_NAME=weft_count
DB_LOGGING=false

# 服务端口
PORT=3180

# JWT 配置（生产环境务必替换为强随机值）
JWT_SECRET=weftcount-dev-secret-change-me
JWT_EXPIRES_IN=7d

# AI 引擎（混合架构 C：大模型只做理解与建议，工艺计算走确定性内核）
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
