# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me_local
DB_NAME=weft_count
DB_LOGGING=false

# 服务端口
PORT=3180

# JWT 配置（生产环境务必替换为强随机值）
JWT_SECRET=weftcount-dev-secret-change-me
JWT_EXPIRES_IN=7d

# AI 引擎（混合架构 C：大模型只做理解与建议，工艺计算走确定性内核）
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# ── 安全配置 ──────────────────────────────────────────────
# 跨源白名单：逗号分隔。留空 = 生产拒绝一切跨源
# （管理端与 API 是同源反代，本来就用不到 CORS）。
# 开发环境留空时默认放行 http://localhost:5180 与 http://127.0.0.1:5180。
CORS_ORIGIN=
# API 文档：生产默认关闭；置 true 开启，可同时配 Basic Auth。
SWAGGER_ENABLED=true
# 文档页 Basic Auth（SWAGGER_ENABLED=true 且两项都填时才启用）。
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASSWORD=
# 全局限速：单 IP 在窗口内允许的请求数 / 窗口长度（毫秒）。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=1200
RATE_LIMIT_TTL=60000
# 登录端点单独收紧：单 IP 每分钟最多尝试次数（账号锁之外的第二道防线）。
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_TTL=60000
# 反向代理信任跳数：1 = 「nginx → server」那一层。
# 限速要按真实客户端 IP 计数，前提是能正确剥掉代理那一层。
TRUST_PROXY=1
